generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  SECURITY
  RECEPTIONIST
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  UMID
  PRC
  POSTAL_ID
  STUDENT_ID
  SSS
  TIN
  COMPANY_ID
  OTHER
}

enum Affiliation {
  VISITOR
  STUDENT
  FACULTY
  STAFF
  ALUMNI
  PARENT
  SUPPLIER
  GOVERNMENT
  OTHER
}

enum VisitType {
  ONE_DAY
  MULTIPLE
}

enum RegistrationMethod {
  PRE_REGISTERED
  WALK_IN
}

enum HostPreference {
  SPECIFIC
  ANY
}

enum VisitPurpose {
  ATTENDANCE
  DELIVERY
  INTERVIEW
  MEETING
  SCHOOL_VISIT
  OTHER
}

enum VisitStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum QRTemplateType {
  SINGLE_USE
  RECURRING
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               UserRole  @default(STAFF)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  mfaRecoveryCodes   String?
  mfaEnrolledAt      DateTime?

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  tokenHash         String    @unique
  userId            String
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  mfaPending        Boolean   @default(false)
  ip                String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  result     String
  ip         String?
  userAgent  String?
  requestId  String?
  meta       Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

model Department {
  id            String   @id @default(uuid())
  name          String   @unique
  building      String?
  contactPerson String?
  contactEmail  String?
  photoPath     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visits     Visit[]
  visitStops VisitStop[]

  @@map("departments")
}

model Visitor {
  id          String      @id @default(uuid())
  firstName   String
  middleName  String?
  lastName    String
  email       String?
  phone       String?
  company     String?
  affiliation Affiliation @default(VISITOR)
  dateOfBirth DateTime?
  idType      IdType
  idNumber    String?
  photoUrl    String?
  idPhotoUrl  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  visits Visit[]

  @@index([email])
  @@index([phone])
  @@map("visitors")
}

model Visit {
  id                 String      @id @default(uuid())
  referenceCode      String      @unique
  visitorId          String
  departmentId       String
  purpose            VisitPurpose
  status             VisitStatus @default(PENDING)
  method             RegistrationMethod @default(WALK_IN)
  visitType          VisitType  @default(ONE_DAY)
  expectedArrival    DateTime?
  actualArrival      DateTime?
  actualDeparture    DateTime?
  hostName           String?
  hostDepartment     String?
  vehicleType        String?
  vehicleModel       String?
  vehicleColor       String?
  vehiclePlateNumber String?
  qrCode             String      @unique
  validFrom          DateTime?
  qrExpiresAt        DateTime?
  qrRevokedAt        DateTime?
  consentVersion     String?
  consentedAt        DateTime?
  checkedInById       String?
  checkedOutById      String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  visitor    Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  stops      VisitStop[]

  @@index([visitorId])
  @@index([departmentId])
  @@index([status])
  @@index([qrCode])
  @@map("visits")
}

model VisitStop {
  id             String          @id @default(uuid())
  visitId        String
  departmentId   String
  building       String?
  purpose        VisitPurpose?
  hostName       String?
  hostPreference HostPreference  @default(ANY)
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  notes          String?

  visit      Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([departmentId])
  @@map("visit_stops")
}

model QRTemplate {
  id        String         @id @default(uuid())
  name      String
  type      QRTemplateType @default(SINGLE_USE)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("qr_templates")
}
